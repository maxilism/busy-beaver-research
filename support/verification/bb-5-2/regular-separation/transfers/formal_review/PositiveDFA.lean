def move (s : State) (symbol : Sym) : State :=
  Fin.ofNat 177 ((packedColumn symbol >>> (8 * s.val)) &&& 255)

def final (s : State) : Bool :=
  [12, 24, 61, 84, 107, 150].contains s.val

def read (s : State) (w : List Sym) : State := w.foldl move s

@[simp] theorem read_nil (s : State) : read s [] = s := rfl
@[simp] theorem read_cons (s : State) (a : Sym) (w : List Sym) :
    read s (a::w) = read (move s a) w := rfl
@[simp] theorem read_singleton (s : State) (a : Sym) :
    read s [a] = move s a := rfl

theorem read_append (s : State) (left right : List Sym) :
    read s (left ++ right) = read (read s left) right := List.foldl_append

theorem move_sink (a : Sym) : move sink a = sink := by
  cases a with
  | bit b => cases b <;> decide
  | mark q => cases q <;> decide

@[simp] theorem read_sink (w : List Sym) : read sink w = sink := by
  induction w with
  | nil => rfl
  | cons a w ih => simpa only [read_cons, move_sink] using ih

@[simp] theorem sink_rejects : final sink = false := by decide

def acceptsWord (w : List Sym) : Prop := final (read start w) = true
def accepts (c : Cfg) : Prop := acceptsWord (display c)

instance (w : List Sym) : Decidable (acceptsWord w) :=
  inferInstanceAs (Decidable (final (read start w) = true))

instance (c : Cfg) : Decidable (accepts c) :=
  inferInstanceAs (Decidable (acceptsWord (display c)))

def machine : Splice.DFA Sym 177 where
  start := start
  move := move
  final s := final s = true

@[simp] theorem machine_accepts (w : List Sym) : machine.accepts w ↔ acceptsWord w := Iff.rfl

theorem accepts_iff (c : Cfg) : accepts c ↔ machine.accepts (display c) := Iff.rfl

end PositiveDFA
