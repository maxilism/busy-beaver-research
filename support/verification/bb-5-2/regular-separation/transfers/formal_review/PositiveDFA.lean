import Lean
import Helix.Tape
import Splice

/-! The partial DFA from the published `dfa.json` for #4817065. The JSON
numbers its states from 0 through 175, uses -1 for missing edges, and reads
columns in the order 01ABCDE. State 176 makes the transition function total.
Run `python3 -IB check_positive_dfa.py` to compare every entry, the accepting
states and the initial state with the pinned original file. -/
namespace PositiveDFA
open Helix

abbrev State := Fin 177
def start : State := 0
def sink : State := 176

def column : Sym → Fin 7
  | .bit false => 0
  | .bit true => 1
  | .mark .A => 2
  | .mark .B => 3
  | .mark .C => 4
  | .mark .D => 5
  | .mark .E => 6

open Lean in
/-- Pack a transition matrix in the alphabet order 01ABCDE into seven natural
numbers. The low byte of each column corresponds to state zero. The source checker compares the
resulting transition function with the published JSON. -/
macro "packedDFAColumns%" rows:term : term => do
  let `(#[ $[$rs],* ]) := rows | Macro.throwErrorAt rows "expected a transition matrix"
  if rs.size > 256 then Macro.throwErrorAt rows "byte packing supports at most 256 states"
  let mut columns := Array.replicate 7 0
  let mut offset := 0
  for r in rs do
    let `(#[ $[$ds],* ]) := r | Macro.throwErrorAt r "expected a row of transition targets"
    if ds.size != 7 then Macro.throwErrorAt r "expected seven targets in order 01ABCDE"
    for j in [:ds.size] do
      let some target := ds[j]!.raw.isNatLit? | Macro.throwErrorAt ds[j]! "expected a state number"
      if target >= rs.size then Macro.throwErrorAt ds[j]! "transition target exceeds the state range"
      columns := columns.modify j fun n => n + (target <<< offset)
    offset := offset + 8
  let n := columns.map fun v => Syntax.mkNumLit (toString v)
  `(fun a : Helix.Sym => match a with
    | .bit false => $(n[0]!)
    | .bit true  => $(n[1]!)
    | .mark .A   => $(n[2]!)
    | .mark .B   => $(n[3]!)
    | .mark .C   => $(n[4]!)
    | .mark .D   => $(n[5]!)
    | .mark .E   => $(n[6]!))

